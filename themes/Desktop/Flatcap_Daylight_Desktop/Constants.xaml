<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Flatcap for Playnite 2.0.0 (Flatcap Daylight). Generated by scripts/build.py from src/theme.json
         (the Flatcap 2.0 core); do not edit by hand. Based on Constants.xaml of Playnite 10.64's Default Desktop theme
         (MIT, Copyright (c) 2020 Josef Nemec). Keys and structure are the original ones: only values change. -->

    <sys:Double x:Key="FontSizeSmall">13</sys:Double> <!-- font.size.meta -->
    <sys:Double x:Key="FontSize">14</sys:Double> <!-- font.size.control -->
    <sys:Double x:Key="FontSizeLarge">15</sys:Double> <!-- font.size.body -->
    <sys:Double x:Key="FontSizeLarger">18</sys:Double> <!-- font.size.heading -->
    <sys:Double x:Key="FontSizeLargest">24</sys:Double> <!-- font.size.title -->
    <FontFamily x:Key="FontFamily">IBM Plex Sans, Segoe UI</FontFamily> <!-- font.ui -->
    <FontFamily x:Key="MonospaceFontFamily">Cascadia Code, Cascadia Code NF, CaskaydiaCove Nerd Font Mono, Consolas</FontFamily> <!-- font.code -->
    <Thickness x:Key="PopupBorderThickness">1</Thickness> <!-- border.width -->
    <Thickness x:Key="ControlBorderThickness">1</Thickness> <!-- border.width -->
    <sys:Double x:Key="EllipseBorderThickness">1</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius> <!-- radius.control -->
    <Thickness x:Key="SidebarItemPadding">8</Thickness>

    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TextColor">#FF28313B</Color> <!-- text.primary -->
    <Color x:Key="TextColorDarker">#FF465463</Color> <!-- text.secondary -->
    <Color x:Key="TextColorDark">#FFFAFBFC</Color> <!-- accent.on -->
    <Color x:Key="MainColor">#FF6C7A89</Color> <!-- border.control -->
    <Color x:Key="MainColorDark">#FFF3F5F7</Color> <!-- bg.canvas -->
    <Color x:Key="HoverColor">#FFE6EBF0</Color> <!-- bg.hover -->
    <Color x:Key="GlyphColor">#FF285D85</Color> <!-- accent.fill -->
    <Color x:Key="HighlightGlyphColor">#FF285D85</Color> <!-- accent.fill -->
    <Color x:Key="PopupBackgroundColor">#FFFFFFFF</Color> <!-- bg.raised -->
    <Color x:Key="PopupBorderColor">#FFD2D9E0</Color> <!-- border.subtle -->
    <Color x:Key="BackgroundToneColor">#FFFFFFFF</Color> <!-- bg.raised -->
    <Color x:Key="GridItemBackgroundColor">#FFFAFBFC</Color> <!-- bg.surface -->
    <Color x:Key="PanelSeparatorColor">#FFD2D9E0</Color> <!-- border.subtle -->
    <Color x:Key="WindowPanelSeparatorColor">#FFD2D9E0</Color> <!-- border.subtle -->
    <Color x:Key="DataChangeNotifColor">#FF765319</Color> <!-- warning.fg -->

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDarker" Color="{DynamicResource TextColorDarker}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="NormalBrush" Color="{DynamicResource MainColor}" />
    <SolidColorBrush x:Key="NormalBrushDark" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="NormalBorderBrush" Color="#FF6C7A89" /> <!-- border.control -->
    <SolidColorBrush x:Key="HoverBrush" Color="#FFE6EBF0" /> <!-- bg.hover -->
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="HighlightGlyphBrush" Color="{DynamicResource HighlightGlyphColor}" />
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{DynamicResource PopupBorderColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{DynamicResource BackgroundToneColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFFFFFFF" /> <!-- bg.raised -->
    <SolidColorBrush x:Key="GridItemBackgroundBrush" Color="{DynamicResource GridItemBackgroundColor}" />
    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="{DynamicResource PanelSeparatorColor}" />
    <SolidColorBrush x:Key="WindowPanelSeparatorBrush" Color="{DynamicResource WindowPanelSeparatorColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFFFF" /> <!-- bg.raised -->
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{DynamicResource MainColorDark}" />
    <SolidColorBrush x:Key="DataChangeNotifBrush" Color="{DynamicResource DataChangeNotifColor}" />

    <SolidColorBrush x:Key="PositiveRatingBrush" Color="#FF32664D" /> <!-- success.fg -->
    <SolidColorBrush x:Key="NegativeRatingBrush" Color="#FFA43F4A" /> <!-- danger.fg -->
    <SolidColorBrush x:Key="MixedRatingBrush" Color="#FF765319" /> <!-- warning.fg -->

    <SolidColorBrush x:Key="WarningBrush" Color="#FFA43F4A" /> <!-- danger.fg -->

    <LinearGradientBrush x:Key="ExpanderBackgroundBrush" StartPoint="-0.1,0.5" EndPoint="1.2,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/> <!-- bg.raised -->
        <GradientStop Color="#00FFFFFF" Offset="0.7"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="WindowBackgourndBrush" Color="#FFF3F5F7" /> <!-- bg.canvas -->

    <!-- Flatcap additions: brushes for the places where the Default theme hardcodes a color. See docs/mapping.md. -->
    <SolidColorBrush x:Key="FlatcapCanvasBrush" Color="#FFF3F5F7" /> <!-- bg.canvas -->
    <SolidColorBrush x:Key="FlatcapSurfaceBrush" Color="#FFFAFBFC" /> <!-- bg.surface -->
    <SolidColorBrush x:Key="FlatcapChipBrush" Color="#FFFFFFFF" /> <!-- bg.raised -->
    <SolidColorBrush x:Key="FlatcapSelectedBrush" Color="#FFDCE9F4" /> <!-- bg.selected -->
    <SolidColorBrush x:Key="FlatcapBadgeBrush" Color="#FFA43F4A" /> <!-- danger.fg -->
    <SolidColorBrush x:Key="FlatcapBadgeTextBrush" Color="#FFFAFBFC" /> <!-- accent.on -->
    <SolidColorBrush x:Key="FlatcapDangerBrush" Color="#FFA43F4A" /> <!-- danger.fg -->
    <SolidColorBrush x:Key="FlatcapWarningBrush" Color="#FF765319" /> <!-- warning.fg -->
    <SolidColorBrush x:Key="FlatcapScrimBrush" Color="#CCF3F5F7" /> <!-- bg.canvas -->
    <SolidColorBrush x:Key="FlatcapScrimTextBrush" Color="#FF28313B" /> <!-- text.primary -->
</ResourceDictionary>