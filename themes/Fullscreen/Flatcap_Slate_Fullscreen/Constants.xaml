<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    mc:Ignorable="d">
    <!-- Flatcap for Playnite 2.0.0 (Flatcap Slate, Fullscreen). Generated by scripts/build.py from src/theme.json
         (the Flatcap 2.0 core); do not edit by hand. Based on Constants.xaml of Playnite 10.64's Default Fullscreen theme
         (MIT, Copyright (c) 2020 Josef Nemec). Keys and structure are the original ones: only colors change. Sizes and fonts are
         Playnite's own (a TV interface needs text of 18 px and up). -->

    <Color x:Key="BlackColor">#FF000000</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="GlyphColor">#FF9BBFDF</Color> <!-- accent.fill -->
    <Color x:Key="GlyphLightColor">#FFACCCE7</Color> <!-- accent.hover -->
    <Color x:Key="SelectionLightColor">#FF8593A5</Color> <!-- border.control -->
    <Color x:Key="OverlayColor">#BB191D22</Color> <!-- bg.canvas -->
    
    <Color x:Key="ControlBackgroundColor">#FF292F36</Color> <!-- bg.raised -->
    <Color x:Key="ControlBackgroundColorDark">#FF191D22</Color> <!-- bg.canvas -->

    <Color x:Key="TextColor">#FFD5DBE3</Color> <!-- text.primary -->
    <Color x:Key="TextColorDark">#FF7E8998</Color> <!-- text.disabled -->

    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="TextBrushDark" Color="{DynamicResource TextColorDark}" />
    <SolidColorBrush x:Key="GlyphBrush" Color="{DynamicResource GlyphColor}" />
    <SolidColorBrush x:Key="GlyphLightBrush" Color="{DynamicResource GlyphLightColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{DynamicResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="ControlBackgroundDarkBrush" Color="{DynamicResource ControlBackgroundColorDark}" />
    <SolidColorBrush x:Key="SelectionLightBrush" Color="{DynamicResource SelectionLightColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{DynamicResource OverlayColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckMarkBkBrush" Color="{DynamicResource ControlBackgroundColorDark}" />

    <sys:Double x:Key="FontSizeSmall">18</sys:Double>
    <sys:Double x:Key="FontSize">22</sys:Double>

    <sys:Double x:Key="FilterPanelWidth">300</sys:Double>
    
    <GridLength x:Key="ProgressWindowWidth">640</GridLength>
    
    <Style x:Key="TextBlockBaseStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontTitilliumWebLight}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <SolidColorBrush x:Key="MainBackgourndBrush" Color="#FF191D22" /> <!-- bg.canvas -->

    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5" >
        <GradientStop Color="#FF20252B" Offset="0"/> <!-- bg.surface -->
        <GradientStop Color="#CC20252B" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1" >
        <GradientStop Color="#FF20252B" Offset="0"/> <!-- bg.surface -->
        <GradientStop Color="#CC20252B" Offset="1.0"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="OverlayMenuBackgroundBrush" Color="#FF20252B" /> <!-- bg.surface -->

    <LinearGradientBrush x:Key="SelectionBrush" StartPoint="0.5,-0.5" EndPoint="1,1.5" >
        <GradientStop Color="{DynamicResource GlyphColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource GlyphLightColor}" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4" >
        <GradientStop Color="#00191D22" Offset="0.0"/> <!-- bg.canvas -->
        <GradientStop Color="#EE191D22" Offset="0.8"/>
    </LinearGradientBrush>
    
    <SolidColorBrush x:Key="WarningBrush" Color="#FFE2A0A5" /> <!-- danger.fg -->

    <!-- Flatcap additions: brushes for the places where the Default theme hardcodes a color. See docs/mapping.md. -->
    <SolidColorBrush x:Key="FlatcapDangerBrush" Color="#FFE2A0A5" /> <!-- danger.fg -->
    <SolidColorBrush x:Key="FlatcapScrimBrush" Color="#AA191D22" /> <!-- bg.canvas -->
</ResourceDictionary>